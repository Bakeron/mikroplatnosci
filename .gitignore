# Pliki JSON nie trafiają do gita (dane aplikacji, kopie) - poza konfiguracją potrzebną do budowania
*.json
!/pc/package.json
!/pc/package-lock.json
!/pc/neutralino.config.json
!/mobile/package.json
!/mobile/package-lock.json
!/mobile/capacitor.config.json

# Zależności i pliki generowane (odtwarzane przez npm install / neu update / neu build)
node_modules/
bin/
dist/
/pc/resources/js/wersja.js
/pc/resources/js/google.js

# Aplikacja na Androida: składane www/, gotowe APK; klucz podpisu nigdy w repozytorium
/mobile/www/
/mobile/apk/
*.jks
*.keystore

# Narzędzia Claude (skille, ustawienia) - nie część aplikacji; zostają tylko na dysku
.claude/
CLAUDE.local.md
# Wszystkie pliki .md poza README - notatki, audyty, założenia, plany; zostają tylko na dysku
*.md
!/README.md
!/mobile/README.md
!/Podgląd/README.md

# Klucze, hasła i konta usług - nigdy w repozytorium
*.p12
*.pfx
*.pem
*.key
*.der
*.crt
HASLO*
*haslo*
*password*
*secret*
.env
.env.*
google-services.json
GoogleService-Info.plist
*service-account*.json
*credentials*.json
client_secret*.json
# Dzienniki, zrzuty pamięci, kopie i paczki repozytorium
*.log
*.dmp
*.bundle
*.orig
*.bak

# Rzeczy spoza aplikacji
Vibersi/
